{
  "name": "ultimatic-desktop",
  "productName": "Ultimatic",
  "version": "1.0.0",
  "description": "Ultimatic — a local two-player tic-tac-toe arcade. Ultimate (meta) tic-tac-toe plus Forget, Misère, Wild, Gomoku, and Order & Chaos. Hot-seat, no AI, all local.",
  "author": "John Rouhana",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.jprouhana.ultimatic",
    "productName": "Ultimatic",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "!**/*.map"
    ],
    "mac": {
      "category": "public.app-category.board-games",
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ]
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Game"
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    }
  }
}
